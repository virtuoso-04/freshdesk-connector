# ─── Freshdesk Credentials ────────────────────────────────────────────────────
# Your Freshdesk subdomain (the part before .freshdesk.com)
FRESHDESK_DOMAIN=yourcompany

# API key – found under Profile Settings → API Key in your Freshdesk portal.
# The connector uses HTTP Basic Auth: base64(API_KEY:X)
# Never commit a real key; this file is .gitignore-d.
FRESHDESK_API_KEY=your_api_key_here

# ─── Optional tuning ──────────────────────────────────────────────────────────
# Max concurrent outbound Freshdesk API calls (default 5)
FRESHDESK_MAX_CONCURRENT=5

# Minimum delay between requests in ms (default 200 ms = 5 req/s, well within the
# 100 req/min limit on Free/Sprout and Growth plans, and even further under Pro
# (200 req/min) and Enterprise (400 req/min))
FRESHDESK_MIN_DELAY_MS=200

# MCP server transport: "stdio" (default, for Agent Studio / Claude Desktop)
MCP_TRANSPORT=stdio

# Optional HTTP port – only used when MCP_TRANSPORT=http
MCP_HTTP_PORT=3000
