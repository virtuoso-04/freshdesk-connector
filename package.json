{
  "name": "freshdesk-connector",
  "version": "1.0.0",
  "description": "A private MCP connector for Freshdesk — lets Agent Studio agents read tickets, contacts, and conversations.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "freshdesk-connector": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --forceExit --runInBand --coverage",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.6.0",
    "axios-retry": "^4.0.0",
    "bottleneck": "^2.19.5",
    "dotenv": "^16.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
